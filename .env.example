# Copy to .env and fill in your own values.
# .env is git-ignored. NEVER commit real credentials.
# If you leak a key: rotate it first, then clean history. Rotation is the fix.

# ---------- Model provider API keys ----------
# Only set the ones you actually use. Modules state which they need.
ANTHROPIC_API_KEY=
HUGGINGFACE_TOKEN=

# ---------- Local model serving ----------
# Point at a locally running inference server if you use one.
LOCAL_MODEL_BASE_URL=http://localhost:8000/v1

# ---------- Vector store ----------
# Used from module 15 onwards. Defaults work with docker-compose.yml.
VECTOR_STORE=chroma            # chroma | qdrant | pgvector | faiss
CHROMA_HOST=localhost
CHROMA_PORT=8001
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---------- PostgreSQL (pgvector) ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aimlmastery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally-only

# ---------- Experiment tracking ----------
MLFLOW_TRACKING_URI=http://localhost:5000

# ---------- Application settings ----------
LOG_LEVEL=INFO
RANDOM_SEED=42

# ---------- Cost guardrails (used by agent and LLM examples) ----------
# Hard limits so a runaway loop cannot surprise you.
MAX_TOKENS_PER_REQUEST=4096
MAX_REQUESTS_PER_RUN=50
REQUEST_TIMEOUT_SECONDS=60
